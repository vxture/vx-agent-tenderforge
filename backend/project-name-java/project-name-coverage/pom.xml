<?xml version="1.0" encoding="UTF-8"?>
<!--
    GENERATED_BY_AI
    MODEL: claude-opus-5
    DATE: 2026-09-08

    只为覆盖率汇总而存在的模块，不产出任何运行时制品。

    为什么需要它：JaCoCo 的 report-aggregate 只汇总**直接依赖**的模块，
    而 project-name-start 只直接依赖 infrastructure 与 web —— domain 和两个
    application 模块是传递依赖，于是它们的类整个从报告里消失了。
    消失的表现不是报错，是「后端覆盖率 61%」这样一个**少统计了三个模块**的数字，
    而它看起来完全合理。

    这个模块只在 coverage-report profile 里进反应堆（见父 pom），
    所以镜像构建与日常 mvn package 根本看不到它。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.td</groupId>
        <artifactId>czghagent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>czghagent-coverage</artifactId>
    <packaging>pom</packaging>

    <!-- 每一个被测模块都必须列在这里，漏一个就是漏统计一个。 -->
    <dependencies>
        <dependency>
            <groupId>com.td</groupId>
            <artifactId>czghagent-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.td</groupId>
            <artifactId>czghagent-application-command</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.td</groupId>
            <artifactId>czghagent-application-query</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.td</groupId>
            <artifactId>czghagent-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.td</groupId>
            <artifactId>czghagent-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.td</groupId>
            <artifactId>czghagent-start</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
