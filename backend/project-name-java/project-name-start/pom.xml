        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            集成测试跑**真 Postgres**，不是嵌入式替身。基线用了 schema、UUID、
            TIMESTAMPTZ 与 gen_random_uuid()，H2 哪个兼容模式都跑不了；更要紧的是
            「测试跑一种引擎、生产跑另一种」这件事本身——不成立的 SQL 只会在生产暴露。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <build>
        <plugins>
        <!--
            把 deploy/database/ddl/*.sql 复制进测试 classpath。集成测试跑的必须是
            **生产用的那一份文件**——抄一份进 test/resources 会过期，而过期的表现是
            测试全绿、生产建不出表。文件搬走了这一步会直接失败，不会静默跳过。
        -->
        <plugin>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
                <execution>
                    <id>copy-ddl-for-tests</id>
                    <phase>generate-test-resources</phase>
                    <goals><goal>copy-resources</goal></goals>
                    <configuration>
                        <outputDirectory>${project.build.testOutputDirectory}/ddl</outputDirectory>
                        <resources>
                            <resource>
                                <directory>${project.basedir}/../../../deploy/database/ddl</directory>
                                <includes><include>*.sql</include></includes>
                            </resource>
                        </resources>
                    </configuration>
                </execution>
            </executions>
        </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.td.czghagent.Application</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        @{argLine} 是承重的，不是装饰：JaCoCo 的 prepare-agent 把 -javaagent
                        写进名为 argLine 的属性，而这里显式声明 argLine 会把它整个盖掉。
                        盖掉的表现不是报错，是「一个 exec 文件都没有」——JaCoCo 安静地跳过报告，
                        覆盖率显示为 0，看起来像是没写测试。用 @{} 做延迟求值才能两个 agent 并存。
                    -->
                    <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
