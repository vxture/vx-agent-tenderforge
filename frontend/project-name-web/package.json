{
  "name": "czghagent-web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "serve": "npm run dev",
    "dev": "vite --mode dev",
    "dev:beta": "vite --mode beta",
    "dev:prod": "vite --mode prod",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:beta": "tsc -b && vite build --mode beta",
    "build:prod": "tsc -b && vite build --mode prod",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "lint": "eslint . --fix --cache",
    "preview": "vite preview",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.19",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vxture/design-system": "9.0.7",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.12.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.0",
    "tailwindcss": "4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
